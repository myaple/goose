# Builder stage: build goose binary using Rust on UBI 9
FROM registry.access.redhat.com/ubi9/ubi as builder

# Install dependencies required for Rust building
# Install protobuf-compiler dependencies and build from source
RUN dnf install -y --allowerasing libxcb-devel gcc gcc-c++ make dbus git autoconf automake libtool curl unzip && dnf clean all

# Download and install protobuf-compiler
RUN curl -L https://github.com/protocolbuffers/protobuf/releases/download/v25.3/protoc-25.3-linux-x86_64.zip -o protoc.zip \
    && unzip protoc.zip -d /usr/local \
    && rm protoc.zip


RUN curl https://sh.rustup.rs -sSf | sh -s -- -y && \
    source $HOME/.cargo/env

ENV CARGO_HOME=/root/.cargo
ENV PATH=/root/.cargo/bin:${PATH}

WORKDIR /usr/src/goose

# Copy project files
COPY . .

# Build release binary
RUN cargo build --release --bin=goose


# Runtime stage: UBI 9 minimal with required runtime libs
FROM registry.access.redhat.com/ubi9/ubi-minimal

# Install runtime libraries for DBus, keyring, SSL dependencies
RUN microdnf install -y \
    dbus \
    dbus-daemon \
    openssl-libs \
    libsecret \
    libxcb \
    ca-certificates \
    && microdnf clean all

# Copy built goose binary from builder
COPY --from=builder /usr/src/goose/target/release/goose /usr/local/bin/goose

# Default entrypoint to run the goose binary
ENTRYPOINT ["/usr/local/bin/goose"]
