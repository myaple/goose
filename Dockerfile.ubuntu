# Use the official Ubuntu base image
FROM ubuntu:24.04

# Install dependencies required by goose binary
RUN apt-get update && apt-get install -y \
    libssl3 \
    zlib1g \
    libxcb1 \
    libstdc++6 \
    libgcc-s1 \
    libxau6 \
    libxdmcp6 \
    libbsd0 \
    libmd0 \
    && rm -rf /var/lib/apt/lists/*

# Set the working directory
WORKDIR /app

# Copy the goose binary
COPY target/release/goose ./goose

# Make sure the binary is executable
RUN chmod +x ./goose

# Set the entrypoint
ENTRYPOINT ["/app/goose"]
